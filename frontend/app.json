{
  "expo": {
    "name": "MotoTracker",
    "slug": "mototracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_mototracker.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo_mototracker.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_mototracker.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/logo_mototracker.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo_mototracker.png",
          "color": "#2563EB"
        }
      ]
    ]
  }
}
